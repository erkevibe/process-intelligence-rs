[Unit]
Description=Process Intelligence local application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=process-intelligence
Group=process-intelligence
WorkingDirectory=/opt/process-intelligence/current
EnvironmentFile=/etc/process-intelligence/app-environment
LoadCredential=database-url:/etc/process-intelligence/database-url
Environment=PI_DATABASE_URL_FILE=%d/database-url
Environment=PORT=3000
Environment=RUST_LOG=info
ExecStart=/opt/process-intelligence/current/process-intelligence-rs
# The application's graceful shutdown handler listens for SIGINT.
KillSignal=SIGINT
TimeoutStopSec=45
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
