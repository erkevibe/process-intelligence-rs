  "prospective_jvm_flags": [
    "-Xmx512m",
    "-XX:ActiveProcessorCount=2",
    "-XX:-UsePerfData",
    "-da",
    "-Dfile.encoding=UTF-8",
    "-Duser.timezone=UTC",
    "-Djava.awt.headless=true",
    "NEW private user.home/tmp/prefs and console logging bindings before config admission"
  ],
  "protocol": {
    "first_gate": "BOOT_READY actualPID+nonce; assignedJob BEFORE GO nonce; no benchmarkapplicationwork beforeGO",
    "terminal_gate": "closed/flushed outputs and completeledger; TERMINAL_READY actualPID+nonce+hashes; wait EXIT nonce whileRootcaptures native lifetime counters",
    "primary_timer": "System.nanoTime immediately before actualmine call to return/throw in finally; GC/internalfallback included; parse/construction/export excluded",
    "parse_policy": "Read immutablebytes onceafterGO; fresh actualparser/XLog/miner/classifier eachcall outsideenginetimer",
    "no_forced_gc_cache_reset_or_result_selection": true,
    "process_wall_label": "instrumented process lifetime including bothgatewaits; activepipeline/gates separately reported",
    "memory_primary_native_fields": [
      "PROCESS_MEMORY_COUNTERS_EX.PeakWorkingSetSize",
      "PROCESS_MEMORY_COUNTERS_EX.PeakPagefileUsage"
    ],
    "memory_not_claimed": [
      "heapcap equals RAM",
      "periodic samplemax equals lifetimepeak",
      "warmbatch equals percall",
      "freshJVM means coldOScache"
    ],
    "cpu_primary_native_fields": [
      "GetProcessTimes.UserTime100ns",
      "GetProcessTimes.KernelTime100ns"
    ],
    "job_counters_assignment_interval_and_membership_explicit": true,
    "terminal_hold_limit_seconds": 10,
    "phase_wall_limit_seconds": 3600,
    "all_native_outcomes_and_unexecuted_calls_retained": true
  },
  "semantic_gate": {
    "primary": "full raw BPMN semantic XML isomorphism + explicit complete ID/ref bijection against same-case historicaloutput and allrepetitions",
    "ignored_only": [
      "entire BPMNDI/DI/DC editorlayoutsubtrees",
      "raw spelling of semanticIDs ONLYunder checkedbijection"
    ],
    "preserved": [
      "all namespace-expanded semantic element/attribute names",
      "labels includingUnicode/case/whitespace",
      "allactivity flags",
      "event type/trigger/use/interrupting/multiple",
      "gatewaytype/marker",
